{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "npm run build",
  "outputDirectory": "public",
  "redirects": [
    { "source": "/blog", "destination": "/blog/", "permanent": true },
    { "source": "/blog/piloten-oefenen-in-een-simulator", "destination": "/blog/piloten-oefenen-in-een-simulator/", "permanent": true },
    { "source": "/blog/nieuwe-bellers-oefenen-op-je-klanten", "destination": "/blog/piloten-oefenen-in-een-simulator/", "permanent": true },
    { "source": "/blog/nieuwe-bellers-oefenen-op-je-klanten/", "destination": "/blog/piloten-oefenen-in-een-simulator/", "permanent": true },
    { "source": "/blog/nieuwe-bellers-oefenen-op-je-klanten/:path*", "destination": "/blog/piloten-oefenen-in-een-simulator/", "permanent": true }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'sha256-UK2jH5sfk3/WcCJmmTiVAR2PKnVX1ISNoWCl/ZZEPoU=' 'sha256-w41zHuxssv1zfrb85N1HT4ZZXg4aYj03XawaaDNPv2Q=' 'sha256-HXevM+JO7UpcEV042dmnhtYR7mOlomL1A4JnSnrDJnY='; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data:; media-src 'self'; connect-src 'self' https://*.vercel-insights.com; manifest-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'none'; upgrade-insecure-requests"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=63072000; includeSubDomains"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), browsing-topics=()"
        }
      ]
    }
  ]
}
